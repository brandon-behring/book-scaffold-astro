---
/**
 * Consumer-defined component — registered via defineMdxComponents in
 * src/mdx-components.ts. Exercises the issue #2 virtual-module plumbing:
 * the scaffold's auto-injected /print route should render this box via
 * the virtual:book-scaffold/mdx-components import.
 */
interface Props {
  title?: string;
}
const { title } = Astro.props;
---
<aside class="narrative-box">
  {title && <strong>{title}</strong>}
  <slot />
</aside>

<style>
  .narrative-box {
    border-left: 3px solid var(--color-link);
    padding: var(--space-3) var(--space-4);
    margin: var(--space-4) 0;
    background: var(--color-bg-subtle);
    border-radius: var(--radius-md);
  }
  .narrative-box strong {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-link);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
