{
  "name": "book-scaffold-astro",
  "description": "GitHub template for long-form technical books: Astro + MDX + Paged.js + Pagefind with Tufte typography and Koller-Friedman chapter structure. Replace this description with your book's.",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prebuild": "npm run build:bib",
    "predev": "npm run build:bib",
    "build:bib": "node scripts/build-bib.mjs",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "build:astro": "astro build",
    "index": "pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "pdf:render": "mkdir -p dist-pdf && pagedjs-cli http://localhost:4321/print/ -o dist-pdf/book.pdf",
    "pdf": "start-server-and-test preview http://localhost:4321/ pdf:render"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/preact": "^5.1.1",
    "@fontsource-variable/roboto": "^5.2.10",
    "@fontsource-variable/source-code-pro": "^5.2.7",
    "@citation-js/core": "^0.7.21",
    "@citation-js/plugin-bibtex": "^0.7.21",
    "astro": "^6.1.7",
    "katex": "^0.16.11",
    "pagefind": "^1.5.2",
    "preact": "^10.29.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "pagedjs-cli": "^0.4.3",
    "start-server-and-test": "^3.0.2"
  }
}
