---
/**
 * /chapters — book index page.
 *
 * Route-level concerns kept here:
 *   - Data fetch (getAllChapters)
 *   - byPart Map grouping (insertion-order preserved across number + string keys)
 *   - ToolFilter island wiring (inline script, data-tools attribute on cards,
 *     part-group hide-when-empty, filter hint)
 *   - CSS, structural JSX, <Base> wrapping
 *
 * Per-profile concerns dispatched via `PROFILES[BOOK_PROFILE].chaptersRenderer`:
 *   - Meta-row composition (numbering, badges)
 *   - Sort key strategy
 *   - data-tools value computation
 *
 * v3.7.0 (closes #35): replaces the field-presence discriminator that
 * lived inline in v3.5.2. Each profile now ships a ChaptersRenderer
 * implementing the strategy interface; consumers opting profiles without
 * a dedicated renderer (e.g., minimal + routes.chapters: true) get the
 * fallbackChaptersRenderer which dispatches via field presence — exactly
 * the v3.5.2 behavior, preserved as a safety net.
 */
import Base from '../layouts/Base.astro';
import { getAllChapters, type Chapter } from '../src/lib/chapters';
import { PROFILES } from '../src/profiles/index';
import { fallbackChaptersRenderer } from '../src/profiles/renderers/fallback-chapters';
import type { ChaptersRenderer, PartKey } from '../src/lib/chapters-renderer';

// #142: prefix BASE_URL so chapter-card links stay inside a non-root deploy base.
const baseUrl = (import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/');

const profileName = (import.meta.env.BOOK_PROFILE ?? 'minimal') as keyof typeof PROFILES;
const profileDef = PROFILES[profileName];
const renderer: ChaptersRenderer =
  (profileDef as { chaptersRenderer?: ChaptersRenderer } | undefined)?.chaptersRenderer
  ?? fallbackChaptersRenderer;

const chapters = await getAllChapters();

// Precompute each card's render-ready fields in the frontmatter block.
// This keeps TypeScript generics (Record<string, unknown> casts, the
// renderer return-type unions) out of the JSX template, where the
// Astro compiler treats `<` as a tag-start token and trips on type
// assertions inside expressions.
interface CardData {
  c: Chapter;
  toolsAttr: string;
  number: string;
  volatility: ReturnType<typeof renderer.getVolatilityData>;
  status: ReturnType<typeof renderer.getStatusData>;
  freshness: ReturnType<typeof renderer.getFreshnessData>;
  freshnessText: string | null;
  verifiedLabel: string | null;
  toolsCompared: string[];
  data: { title: unknown; description?: unknown };
}

function buildCard(c: Chapter, appendix: boolean): CardData {
  const data = c.data as Record<string, unknown>;
  const freshness = renderer.getFreshnessData(data);
  const freshnessText = freshness
    ? freshness.status === 'fresh'
      ? 'Fresh'
      : freshness.status === 'verify-soon'
        ? 'Verify soon'
        : 'Stale'
    : null;
  return {
    c,
    toolsAttr: renderer.getToolsAttr(data),
    number: renderer.formatChapterNumber(data, appendix),
    volatility: renderer.getVolatilityData(data),
    status: renderer.getStatusData(data),
    freshness,
    freshnessText,
    verifiedLabel: renderer.getVerifiedDateLabel(data),
    toolsCompared: renderer.getToolsCompared(data),
    data: { title: data.title, description: data.description as string | undefined },
  };
}

// Stable insertion-order grouping. Map preserves order for both number and
// string keys (academic uses string-enum parts; tools uses numeric parts).
const byPart = new Map<PartKey, CardData[]>();
for (const c of chapters) {
  const key = renderer.partKey(c.data as Record<string, unknown>);
  const appendix = renderer.isAppendix(key);
  const card = buildCard(c, appendix);
  const list = byPart.get(key);
  if (list) list.push(card);
  else byPart.set(key, [card]);
}
---
<Base
  title="Chapters"
  description="All chapters grouped by Part."
>
  <article class="prose chapters-index">
    <header class="chapters-index-header">
      <h1>Chapters</h1>
      <p class="chapters-index-lede">
        Every chapter, grouped by Part. Use the card metadata to calibrate
        how much trust to place in a chapter's specific claims.
      </p>
    </header>

    <p class="chapters-filter-hint" id="filter-hint" aria-live="polite"></p>

    {Array.from(byPart.entries()).map(([part, cards]) => (
      <section class="part-group">
        <h2 class="part-heading">
          <span class="part-label">{renderer.formatPartLabel(part)}</span>
        </h2>
        <ol class="chapter-list">
          {cards.map((card) => (
            <li class="chapter-card" data-tools={card.toolsAttr}>
              <a href={`${baseUrl}chapters/${card.c.id}/`} class="chapter-card-link">
                <div class="chapter-card-meta">
                  <span class="chapter-card-number">{card.number}</span>
                  {card.volatility && (
                    <span
                      class={`volatility-badge volatility-${card.volatility.level}`}
                      title={`Volatility: ${card.volatility.label}`}
                    >{card.volatility.label}</span>
                  )}
                  {card.status && (
                    <span
                      class={`status-badge status-${card.status.status}`}
                      title={`Status: ${card.status.label}`}
                    >{card.status.label}</span>
                  )}
                  {card.freshness && card.freshnessText && (
                    <span
                      class="freshness-badge"
                      data-status={card.freshness.status}
                      aria-label={card.freshness.label}
                      title={card.freshness.label}
                    >{card.freshnessText}</span>
                  )}
                  {card.verifiedLabel && (
                    <span class="chapter-card-verified">{card.verifiedLabel}</span>
                  )}
                </div>
                <h3 class="chapter-card-title">{card.data.title}</h3>
                {card.data.description && (
                  <p class="chapter-card-description">{card.data.description as string}</p>
                )}
                {card.toolsCompared.length > 0 && (
                  <div class="chapter-card-tools">
                    {card.toolsCompared.map((t) => (
                      <span class="tool-badge">{t}</span>
                    ))}
                  </div>
                )}
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </article>
</Base>

{/* Inline non-island script: applies tool filter from localStorage on
    load, then reacts to ToolFilter island's "book:tool-filter:change"
    CustomEvent. Handled as plain DOM so /chapters/ doesn't need its
    own hydration island. */}
<script is:inline>
  (function () {
    var STORAGE_KEY = 'book:tool-filter';
    var EVENT_NAME = 'book:tool-filter:change';

    function readSelected() {
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return [];
        var parsed = JSON.parse(raw);
        return Array.isArray(parsed) ? parsed : [];
      } catch (e) {
        return [];
      }
    }

    function applyFilter(selected) {
      var cards = document.querySelectorAll('.chapter-card[data-tools]');
      var shownCount = 0;
      var totalCount = cards.length;
      var active = Array.isArray(selected) && selected.length > 0;

      cards.forEach(function (card) {
        var attr = card.getAttribute('data-tools') || '';
        var tools = attr.split(/\s+/).filter(Boolean);
        var isCrossTool = tools.indexOf('cross-tool') !== -1;
        var overlaps = false;
        for (var i = 0; i < tools.length; i++) {
          if (selected.indexOf(tools[i]) !== -1) {
            overlaps = true;
            break;
          }
        }

        var hidden = active && !overlaps && !isCrossTool;
        if (hidden) {
          card.setAttribute('data-hidden-by-filter', 'true');
        } else {
          card.removeAttribute('data-hidden-by-filter');
          shownCount++;
        }
      });

      // Hide entire part sections that become empty under the filter.
      document.querySelectorAll('.part-group').forEach(function (group) {
        var visible = group.querySelectorAll(
          '.chapter-card:not([data-hidden-by-filter="true"])',
        );
        if (visible.length === 0) {
          group.setAttribute('data-hidden-by-filter', 'true');
        } else {
          group.removeAttribute('data-hidden-by-filter');
        }
      });

      // Update the hint line.
      var hint = document.getElementById('filter-hint');
      if (hint) {
        if (!active) {
          hint.textContent = '';
        } else {
          hint.textContent =
            'Showing ' + shownCount + ' of ' + totalCount +
            ' chapters (filter: ' + selected.join(', ') + ').' +
            ' Cross-tool chapters stay visible.';
        }
      }
    }

    // Apply saved filter on first load, before the island hydrates.
    applyFilter(readSelected());

    // React to subsequent changes from the ToolFilter island.
    window.addEventListener(EVENT_NAME, function (e) {
      var detail = e && e.detail ? e.detail : {};
      applyFilter(Array.isArray(detail.selected) ? detail.selected : []);
    });
  })();
</script>

<style>
  .chapters-index-header {
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-6);
  }
  .chapters-index-lede {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 65ch;
  }
  .chapters-index-cross-ref {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-3);
    text-indent: 0;
  }

  .part-group {
    margin: var(--space-8) 0;
  }
  .part-heading {
    font-size: var(--text-sm);
    font-family: var(--font-code);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .part-label {
    font-weight: 500;
  }

  .chapter-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }

  .chapter-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    transition:
      border-color 120ms ease,
      background 120ms ease,
      opacity 180ms ease,
      max-height 220ms ease;
    max-height: 40rem; /* ceiling for the transition; actual height is auto */
    overflow: hidden;
  }
  .chapter-card:hover {
    border-color: var(--color-link);
    background: var(--color-bg-subtle);
  }
  .chapter-card-link {
    display: block;
    padding: var(--space-4);
    text-decoration: none;
    color: inherit;
  }
  .chapter-card-link:hover {
    text-decoration: none;
  }

  .chapter-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }
  .chapter-card-number {
    font-family: var(--font-code);
    font-weight: 500;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: var(--text-xs);
  }
  .chapter-card-verified {
    font-family: var(--font-code);
    font-size: var(--text-xs);
  }

  .chapter-card-title {
    font-size: var(--text-lg);
    font-weight: 500;
    margin: 0 0 var(--space-2) 0;
    color: var(--color-link);
  }
  .chapter-card-description {
    color: var(--color-text);
    margin: 0 0 var(--space-3) 0;
    text-indent: 0;
    line-height: 1.5;
  }
  .chapter-card-tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Filter target: cards fade + collapse smoothly; full display:none
   * kicks in after the transition so we don't keep a focusable node
   * in the list. Part-groups collapse immediately because they're
   * structural, not reader-facing. */
  .chapter-card[data-hidden-by-filter='true'] {
    opacity: 0;
    max-height: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .chapter-card[data-hidden-by-filter='true'] .chapter-card-link {
    visibility: hidden;
  }
  .part-group[data-hidden-by-filter='true'] {
    display: none;
  }

  .chapters-filter-hint {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
    margin: var(--space-2) 0 var(--space-4) 0;
    min-height: 1.4em;
  }
  .chapters-filter-hint:empty {
    margin: 0;
    min-height: 0;
  }

  /* Print override: the filter UI doesn't exist in print (chrome is
   * hidden), so all chapters must render regardless of any filter
   * state left over in the viewer. */
  @media print {
    .chapter-card[data-hidden-by-filter='true'] {
      opacity: 1;
      max-height: none;
      margin: unset;
      padding: unset;
      border-width: 1px;
      pointer-events: auto;
      overflow: visible;
    }
    .chapter-card[data-hidden-by-filter='true'] .chapter-card-link {
      visibility: visible;
    }
    .part-group[data-hidden-by-filter='true'] {
      display: block;
    }
    .chapters-filter-hint {
      display: none;
    }
  }

  /* Reduced-motion: skip the opacity/height transition for anyone who
   * prefers less motion. The display change is instant either way. */
  @media (prefers-reduced-motion: reduce) {
    .chapter-card {
      transition: border-color 120ms ease, background 120ms ease;
    }
  }
</style>
