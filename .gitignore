# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Playwright source captures: metadata tracked in sources/manifest.yaml;
# full HTML/screenshots/PDF stay local for drift detection only.
sources/cache/*
!sources/cache/.gitkeep

# PDF build output
dist-pdf/

# Build artifacts derived from sibling source files (regenerated on
# every npm run dev/build via prebuild hook; see "build:assets" in package.json).
#
# - references.json: gitleaks entropy-flags bibkeys (e.g. gu2024mamba)
#   as false-positive API keys; the .gitleaks.toml allowlist covers
#   .mdx + .bib but JSON is rederivable so we gitignore it.
# - public/figures/ + public/notebooks/: by default, gitignored — local
#   devs regenerate. Books deploying to Cloudflare Workers (whose build
#   container lacks pdftocairo + uv) should comment these out so the
#   scripts gracefully skip and CI serves the committed artifacts as-is.
src/data/references.json
demo/src/data/references.json
public/figures/
public/notebooks/
