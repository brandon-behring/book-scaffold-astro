---
/**
 * /chapters — book index page.
 *
 * Groups non-draft chapters by Part in ascending order. Each card exposes
 * `data-tools="<slug> <slug>..."` so the ToolFilter island can hide cards via
 * a single attribute selector without touching card rendering.
 *
 * v3.5.2 (closes #24): schema-aware. Previously hardcoded the tools-profile
 * shape and crashed on academic profile (no `chapter` / `volatility` /
 * `tools_compared` / `last_verified`). Now renders either shape:
 *   - tools: `Chapter N` + volatility badge + freshness + tools-compared tags
 *   - academic: `Week N` + status badge (no freshness or tools-compared)
 * Field presence is the schema discriminator (cheaper than reading
 * BOOK_PROFILE at the route layer).
 */
import Base from '../layouts/Base.astro';
import { getAllChapters, type Chapter } from '../src/lib/chapters';
import { getFreshness, freshnessLabel } from '../src/lib/freshness';

const chapters = await getAllChapters();

// Stable insertion-order grouping by `part`. Map key may be number (tools) or
// string (academic enum); Map preserves insertion order for both.
type PartKey = string | number;
const byPart = new Map<PartKey, Chapter[]>();
for (const c of chapters) {
  const key = (c.data as { part: PartKey }).part;
  const list = byPart.get(key);
  if (list) list.push(c);
  else byPart.set(key, [c]);
}

function formatDate(d: Date): string {
  return d.toISOString().slice(0, 10);
}

/** Render-ready label for a Part heading. Tools: "Part N" or "Appendices"
 *  (parts >= 6 are appendices). Academic: titlecase the enum string. */
function partLabel(part: PartKey): string {
  if (typeof part === 'number') {
    return part >= 6 ? 'Appendices' : `Part ${part}`;
  }
  return part
    .split('-')
    .map((w) => (w.length ? w[0].toUpperCase() + w.slice(1) : ''))
    .join(' ');
}

function isAppendix(part: PartKey): boolean {
  return typeof part === 'number' && part >= 6;
}

/** Per-card schema detection. Cheaper than reading BOOK_PROFILE — the shape
 *  of the chapter's data already tells us which profile produced it. */
function isToolsShape(data: Record<string, unknown>): boolean {
  return 'volatility' in data && 'chapter' in data;
}
---
<Base
  title="Chapters"
  description="All chapters grouped by Part."
>
  <article class="prose chapters-index">
    <header class="chapters-index-header">
      <h1>Chapters</h1>
      <p class="chapters-index-lede">
        Every chapter, grouped by Part. Use the card metadata to calibrate
        how much trust to place in a chapter's specific claims.
      </p>
    </header>

    <p class="chapters-filter-hint" id="filter-hint" aria-live="polite"></p>

    {Array.from(byPart.entries()).map(([part, list]) => {
      const appendix = isAppendix(part);
      return (
        <section class="part-group">
          <h2 class="part-heading">
            <span class="part-label">{partLabel(part)}</span>
          </h2>
          <ol class="chapter-list">
            {list.map((c) => {
              const data = c.data as Record<string, unknown>;
              const tools = isToolsShape(data);
              // data-tools attribute drives the ToolFilter island. Academic
              // cards opt out by claiming "cross-tool" — always visible
              // regardless of filter state.
              const toolsAttr = tools
                ? (data.tools_compared as string[]).join(' ')
                : 'cross-tool';
              const freshness = tools
                ? getFreshness(data.last_verified as Date, data.volatility as Parameters<typeof getFreshness>[1])
                : null;
              const freshnessText = freshness
                ? freshness.status === 'fresh'
                  ? 'Fresh'
                  : freshness.status === 'verify-soon'
                    ? 'Verify soon'
                    : 'Stale'
                : null;
              return (
                <li class="chapter-card" data-tools={toolsAttr}>
                  <a href={`/${c.id}/`} class="chapter-card-link">
                    <div class="chapter-card-meta">
                      <span class="chapter-card-number">
                        {tools
                          ? appendix
                            ? `Appendix ${String.fromCharCode(64 + (data.chapter as number)).toLowerCase()}`
                            : `Chapter ${data.chapter}`
                          : `Week ${data.week}`}
                      </span>
                      {tools && (
                        <span
                          class={`volatility-badge volatility-${data.volatility}`}
                          title={`Volatility: ${data.volatility}`}
                        >{data.volatility}</span>
                      )}
                      {!tools && data.status && (
                        <span
                          class={`status-badge status-${data.status}`}
                          title={`Status: ${data.status}`}
                        >{data.status}</span>
                      )}
                      {freshness && freshnessText && (
                        <span
                          class="freshness-badge"
                          data-status={freshness.status}
                          aria-label={freshnessLabel(freshness)}
                          title={freshnessLabel(freshness)}
                        >{freshnessText}</span>
                      )}
                      {tools && data.last_verified && (
                        <span class="chapter-card-verified">
                          verified {formatDate(data.last_verified as Date)}
                        </span>
                      )}
                    </div>
                    <h3 class="chapter-card-title">{data.title}</h3>
                    {data.description && (
                      <p class="chapter-card-description">{data.description as string}</p>
                    )}
                    {tools && (
                      <div class="chapter-card-tools">
                        {(data.tools_compared as string[]).map((t) => (
                          <span class="tool-badge">{t}</span>
                        ))}
                      </div>
                    )}
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
      );
    })}
  </article>
</Base>

{/* Inline non-island script: applies tool filter from localStorage on
    load, then reacts to ToolFilter island's "book:tool-filter:change"
    CustomEvent. Handled as plain DOM so /chapters/ doesn't need its
    own hydration island. */}
<script is:inline>
  (function () {
    var STORAGE_KEY = 'book:tool-filter';
    var EVENT_NAME = 'book:tool-filter:change';

    function readSelected() {
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return [];
        var parsed = JSON.parse(raw);
        return Array.isArray(parsed) ? parsed : [];
      } catch (e) {
        return [];
      }
    }

    function applyFilter(selected) {
      var cards = document.querySelectorAll('.chapter-card[data-tools]');
      var shownCount = 0;
      var totalCount = cards.length;
      var active = Array.isArray(selected) && selected.length > 0;

      cards.forEach(function (card) {
        var attr = card.getAttribute('data-tools') || '';
        var tools = attr.split(/\s+/).filter(Boolean);
        var isCrossTool = tools.indexOf('cross-tool') !== -1;
        var overlaps = false;
        for (var i = 0; i < tools.length; i++) {
          if (selected.indexOf(tools[i]) !== -1) {
            overlaps = true;
            break;
          }
        }

        var hidden = active && !overlaps && !isCrossTool;
        if (hidden) {
          card.setAttribute('data-hidden-by-filter', 'true');
        } else {
          card.removeAttribute('data-hidden-by-filter');
          shownCount++;
        }
      });

      // Hide entire part sections that become empty under the filter.
      document.querySelectorAll('.part-group').forEach(function (group) {
        var visible = group.querySelectorAll(
          '.chapter-card:not([data-hidden-by-filter="true"])',
        );
        if (visible.length === 0) {
          group.setAttribute('data-hidden-by-filter', 'true');
        } else {
          group.removeAttribute('data-hidden-by-filter');
        }
      });

      // Update the hint line.
      var hint = document.getElementById('filter-hint');
      if (hint) {
        if (!active) {
          hint.textContent = '';
        } else {
          hint.textContent =
            'Showing ' + shownCount + ' of ' + totalCount +
            ' chapters (filter: ' + selected.join(', ') + ').' +
            ' Cross-tool chapters stay visible.';
        }
      }
    }

    // Apply saved filter on first load, before the island hydrates.
    applyFilter(readSelected());

    // React to subsequent changes from the ToolFilter island.
    window.addEventListener(EVENT_NAME, function (e) {
      var detail = e && e.detail ? e.detail : {};
      applyFilter(Array.isArray(detail.selected) ? detail.selected : []);
    });
  })();
</script>

<style>
  .chapters-index-header {
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-6);
  }
  .chapters-index-lede {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 65ch;
  }
  .chapters-index-cross-ref {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-3);
    text-indent: 0;
  }

  .part-group {
    margin: var(--space-8) 0;
  }
  .part-heading {
    font-size: var(--text-sm);
    font-family: var(--font-code);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .part-label {
    font-weight: 500;
  }

  .chapter-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }

  .chapter-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    transition:
      border-color 120ms ease,
      background 120ms ease,
      opacity 180ms ease,
      max-height 220ms ease;
    max-height: 40rem; /* ceiling for the transition; actual height is auto */
    overflow: hidden;
  }
  .chapter-card:hover {
    border-color: var(--color-link);
    background: var(--color-bg-subtle);
  }
  .chapter-card-link {
    display: block;
    padding: var(--space-4);
    text-decoration: none;
    color: inherit;
  }
  .chapter-card-link:hover {
    text-decoration: none;
  }

  .chapter-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }
  .chapter-card-number {
    font-family: var(--font-code);
    font-weight: 500;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: var(--text-xs);
  }
  .chapter-card-verified {
    font-family: var(--font-code);
    font-size: var(--text-xs);
  }

  .chapter-card-title {
    font-size: var(--text-lg);
    font-weight: 500;
    margin: 0 0 var(--space-2) 0;
    color: var(--color-link);
  }
  .chapter-card-description {
    color: var(--color-text);
    margin: 0 0 var(--space-3) 0;
    text-indent: 0;
    line-height: 1.5;
  }
  .chapter-card-tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Filter target: cards fade + collapse smoothly; full display:none
   * kicks in after the transition so we don't keep a focusable node
   * in the list. Part-groups collapse immediately because they're
   * structural, not reader-facing. */
  .chapter-card[data-hidden-by-filter='true'] {
    opacity: 0;
    max-height: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .chapter-card[data-hidden-by-filter='true'] .chapter-card-link {
    visibility: hidden;
  }
  .part-group[data-hidden-by-filter='true'] {
    display: none;
  }

  .chapters-filter-hint {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
    margin: var(--space-2) 0 var(--space-4) 0;
    min-height: 1.4em;
  }
  .chapters-filter-hint:empty {
    margin: 0;
    min-height: 0;
  }

  /* Print override: the filter UI doesn't exist in print (chrome is
   * hidden), so all chapters must render regardless of any filter
   * state left over in the viewer. */
  @media print {
    .chapter-card[data-hidden-by-filter='true'] {
      opacity: 1;
      max-height: none;
      margin: unset;
      padding: unset;
      border-width: 1px;
      pointer-events: auto;
      overflow: visible;
    }
    .chapter-card[data-hidden-by-filter='true'] .chapter-card-link {
      visibility: visible;
    }
    .part-group[data-hidden-by-filter='true'] {
      display: block;
    }
    .chapters-filter-hint {
      display: none;
    }
  }

  /* Reduced-motion: skip the opacity/height transition for anyone who
   * prefers less motion. The display change is instant either way. */
  @media (prefers-reduced-motion: reduce) {
    .chapter-card {
      transition: border-color 120ms ease, background 120ms ease;
    }
  }
</style>
