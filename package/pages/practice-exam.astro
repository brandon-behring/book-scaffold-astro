---
/**
 * Auto-injected /practice-exam route (v4.17.0, Tier 3 #112).
 *
 * A STATIC practice question-bank: reads the `questions` content collection
 * (src/content/questions/**), groups questions by exam domain, and renders each
 * one's stem (MDX body) + payload (MCQ options | free-response model answer)
 * with the answer behind a collapsible <details> (Bjork desirable-difficulties:
 * the answer stays hidden until the reader reveals it). ZERO scoring JS — the
 * interactive scored engine is a later increment; v1 is framed as a "question
 * bank", not a timed/scored "Practice Exam".
 *
 * Twin-gate (mirrors convergence.astro #86): a book may set
 * routes.practiceExam: true without a src/content/questions/ directory — then
 * the `questions` collection is never registered and getCollection('questions')
 * would throw. Presence-probe the directory with import.meta.glob and render an
 * honest empty-state when absent; never touch the collection in that case.
 *
 * Fail-loud: every question's `domain` is validated against the consumer's
 * examDomains registry (assertKnownDomain) — an unregistered domain throws at
 * build rather than silently bucketing into a phantom domain.
 *
 * `cloze` questions are schema-accepted but render-deferred (reserved type):
 * they're counted and noted, not rendered, until their renderer ships.
 */
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import bookConfig from 'virtual:book-scaffold/book-config';
import { getAllQuestions, groupByDomain } from '../src/lib/questions';
import { assertKnownDomain } from '../src/lib/exam-domains';

// Presence-gate: only touch the collection when the directory holds files.
const questionModules = import.meta.glob('/src/content/questions/**/*.{md,mdx}', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const hasQuestions = Object.keys(questionModules).length > 0;

const entries = hasQuestions ? await getAllQuestions() : [];

// Fail-loud: every question's domain must be in the examDomains registry.
for (const entry of entries) {
  assertKnownDomain(bookConfig.examDomains, entry.data.domain, { id: entry.data.id });
}

// Render each question's stem (MDX body) at build. cloze is reserved → no render.
const rendered = await Promise.all(
  entries.map(async (entry) => ({
    data: entry.data,
    reserved: entry.data.type === 'cloze',
    Content: entry.data.type === 'cloze' ? null : (await render(entry)).Content,
  })),
);

const byDomain = groupByDomain(rendered);
// Display domains in the consumer's declared order; skip domains with no questions.
const domainOrder = (bookConfig.examDomains ?? []).filter((d) => byDomain.has(d));
const total = rendered.length;
const reservedCount = rendered.filter((r) => r.reserved).length;

/** Filled/hollow diamonds for a 1–4 difficulty, mirroring Practice.astro. */
function difficultyMarks(d: string | undefined): string {
  if (!d) return '';
  const n = Number.parseInt(d, 10);
  return '◆'.repeat(n) + '◇'.repeat(4 - n);
}
---
<Base
  title="Practice question bank"
  description="All practice questions in this book, grouped by exam domain, with answers behind a reveal."
>
  <article class="prose practice-exam">
    <h1>Practice question bank</h1>

    {!hasQuestions && (
      <p class="practice-empty">
        No <code>src/content/questions/</code> directory found. Add question MDX files
        (frontmatter <code>id</code>/<code>type</code>/<code>domain</code> + an MDX stem),
        declare your <code>examDomains</code> in <code>defineBookConfig</code>, and keep
        <code>routes: {'{'} practiceExam: true {'}'}</code>.
      </p>
    )}

    {hasQuestions && total === 0 && (
      <p class="practice-empty">No questions defined yet.</p>
    )}

    {total > 0 && (
      <p class="practice-summary">
        {total} question{total === 1 ? '' : 's'} across {domainOrder.length} domain{domainOrder.length === 1 ? '' : 's'}.
        {reservedCount > 0 && ` (${reservedCount} cloze ${reservedCount === 1 ? 'question' : 'questions'} reserved — rendering deferred.)`}
      </p>
    )}

    {domainOrder.map((domain) => (
      <section class="practice-domain" id={`domain-${domain}`}>
        <h2 class="practice-domain-title">{domain}</h2>
        {byDomain.get(domain)!.map((q) => {
          const Content = q.Content;
          const correct = q.data.type === 'mcq' && q.data.options
            ? q.data.options.find((o) => o.correct)
            : undefined;
          return (
            <article class="question" id={`question-${q.data.id}`}>
              <header class="question-header">
                <span class="question-meta-id">{q.data.id}</span>
                <span class="question-meta-type">{q.data.type}</span>
                {q.data.bloom_level && <span class="question-meta-bloom">{q.data.bloom_level}</span>}
                {q.data.difficulty && (
                  <span class="question-meta-difficulty" aria-label={`Difficulty ${q.data.difficulty} of 4`}>
                    {difficultyMarks(q.data.difficulty)}
                  </span>
                )}
              </header>

              {q.reserved ? (
                <p class="question-reserved">
                  Cloze question — interactive rendering deferred to a later release.
                </p>
              ) : (
                Content && (
                  <div class="question-stem"><Content /></div>
                )
              )}

              {q.data.type === 'mcq' && q.data.options && (
                <ol class="question-options" type="a">
                  {q.data.options.map((o) => (
                    <li class="question-option">{o.text ?? o.id}</li>
                  ))}
                </ol>
              )}

              {!q.reserved && (
                <details class="question-reveal">
                  <summary>Show answer</summary>
                  {q.data.type === 'mcq' && correct && (
                    <p class="question-answer-line">
                      Correct: <strong>{correct.text ?? correct.id}</strong>
                    </p>
                  )}
                  {q.data.type === 'free' && q.data.answer && (
                    <p class="question-answer-line">{q.data.answer}</p>
                  )}
                  {q.data.type === 'mcq' && q.data.answer && (
                    <p class="question-answer-explain">{q.data.answer}</p>
                  )}
                </details>
              )}
            </article>
          );
        })}
      </section>
    ))}
  </article>

  <style>
    .practice-exam { max-width: 48rem; }
    .practice-summary { color: var(--color-text-muted, #6b7280); font-size: 0.95rem; }
    .practice-empty { color: var(--color-text-muted, #6b7280); }
    .practice-domain { margin-block-start: 2rem; }
    .practice-domain-title {
      text-transform: capitalize;
      border-block-end: 2px solid var(--color-border, #e5e7eb);
      padding-block-end: 0.25rem;
    }
    .question {
      margin-block: 1.25rem;
      padding: 1rem 1.1rem;
      border: 1px solid var(--color-border, #e5e7eb);
      border-radius: 0.5rem;
      background: var(--color-surface, transparent);
    }
    .question-header {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: center;
      font-size: 0.78rem;
      color: var(--color-text-muted, #6b7280);
      margin-block-end: 0.5rem;
    }
    .question-meta-id { font-family: var(--font-mono, ui-monospace, monospace); }
    .question-meta-type,
    .question-meta-bloom {
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.05rem 0.4rem;
      border-radius: 0.25rem;
      background: var(--color-code-bg, rgba(127, 127, 127, 0.12));
    }
    .question-meta-difficulty { margin-inline-start: auto; letter-spacing: 0.1em; }
    .question-options { margin-block: 0.6rem; }
    .question-option { margin-block: 0.2rem; }
    .question-reveal { margin-block-start: 0.6rem; }
    .question-reveal > summary {
      cursor: pointer;
      font-weight: 600;
      color: var(--color-accent, #4f46e5);
    }
    .question-answer-line { margin-block: 0.5rem 0.25rem; }
    .question-answer-explain { color: var(--color-text-muted, #6b7280); }
    .question-reserved { color: var(--color-text-muted, #6b7280); font-style: italic; }
  </style>
</Base>
